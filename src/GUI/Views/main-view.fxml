<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../Styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.controllers.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="93.0" prefWidth="566.0" spacing="15" styleClass="top-bar">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <Button onAction="#toggleSideMenu" styleClass="menu-toggle-button" text="Menu" />

            <ImageView fitHeight="45" fitWidth="45" preserveRatio="true">
                <image>
                    <!--<Image url="@../Assets/user.png"/> -->
                </image>
            </ImageView>

            <Label fx:id="usernameLabel" styleClass="username-label" text="Usuario" />

            <Region HBox.hgrow="ALWAYS" />

            <MenuButton styleClass="settings-button">
                <items>
                    <MenuItem text="Perfil"/>
                    <MenuItem text="Configuracion"/>
                    <MenuItem text="Historial medico" onAction="#loadMedical"/>
                    <MenuItem text="Cerrar sesion" onAction="#handleLogout"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <HBox>
            <VBox fx:id="sideMenu" prefWidth="200.0" minWidth="200.0" maxWidth="200.0" prefHeight="288.0" spacing="10" styleClass="side-menu">
                <padding>
                    <Insets left="10" right="10" top="20" />
                </padding>

                <Button onAction="#loadHome" styleClass="menu-button" text="Inicio" />
                <Button onAction="#loadEmergency" styleClass="menu-button" text="Emergencia" />
                <Button onAction="#loadHealth" styleClass="menu-button" text="Monitor salud" />
                <Button onAction="#loadVoice" styleClass="menu-button" text="Deteccion voz" />
                <Button onAction="#loadDanger" styleClass="menu-button" text="Alerta peligro" />
                <Button onAction="#loadCenters" styleClass="menu-button" text="Centros cercanos" />
            </VBox>

            <StackPane fx:id="contentArea" styleClass="content-area" HBox.hgrow="ALWAYS">
                <VBox alignment="CENTER" prefHeight="288.0" prefWidth="510.0" spacing="10">
                    <Label styleClass="title" text="Asistencia de Emergencia" />
                    <Label text="Selecciona una opcion del menu" />
                </VBox>
            </StackPane>
        </HBox>
    </center>

</BorderPane>
