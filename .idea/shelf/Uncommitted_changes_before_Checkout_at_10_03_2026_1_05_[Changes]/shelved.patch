+package Resources;
+
+import java.util.Scanner;
+
+public class VoiceEmergencyListener {
+
+    private boolean running = true;
+
+    public void startListening(EmergencyManager manager) {
+
+        Scanner scanner = new Scanner(System.in);
+
+        System.out.println("Sistema de activación por voz (simulado)");
+        System.out.println("Introduce la palabra clave de emergencia.");
+
+        while (running) {
+
+            System.out.print("Entrada de voz simulada: ");
+
+            String input = scanner.nextLine().toLowerCase();
+
+            manager.processVoiceInput(input);
+        }
+    }
+
+    public void stop() {
+        running = false;
+    }
+}
