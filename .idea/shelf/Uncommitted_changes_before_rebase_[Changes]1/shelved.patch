+package Resources;
+
+import java.util.Scanner;
+
+public class VoiceListener {
+
+    private String keyword;
+
+    public VoiceListener(String keyword) {
+        this.keyword = keyword.toLowerCase();
+    }
+
+    public boolean listenForKeyword() {
+
+        Scanner scanner = new Scanner(System.in);
+
+        System.out.println("Sistema de escucha activado...");
+        System.out.println("Di algo (simulación por texto):");
+
+        String input = scanner.nextLine().toLowerCase();
+
+        if (input.contains(keyword)) {
+            System.out.println(" Palabra clave detectada: " + keyword);
+            return true;
+        }
+
+        return false;
+    }
+}
