+package Resources;
+
+public class VoiceEmergencyDetector {
+
+    private VoiceListener listener;
+
+    public VoiceEmergencyDetector(String keyword) {
+        listener = new VoiceListener(keyword);
+    }
+
+    public EmergencyEvent detectVoiceEmergency() {
+
+        boolean detected = listener.listenForKeyword();
+        UserData usuario = new UserData("Usuario desconocido");
+        if (detected) {
+            System.out.println("Emergencia activada por voz.");
+            return new EmergencyEvent("Activación por voz",
+                    "Ubicación desconocida", usuario, 0 );
+        }
+
+        return null;
+    }
+}
