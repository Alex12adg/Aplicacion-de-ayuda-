+package Resources;
+
+import java.util.Scanner;
+
+public class VoiceAlertSystem {
+
+    public void startVoiceMonitoring() {
+
+        Scanner scanner = new Scanner(System.in);
+
+        System.out.println("Introduce la palabra clave de emergencia (ENTER para usar 'socorro'):");
+
+        String keyword = scanner.nextLine();
+
+        if (keyword.isEmpty()) {
+            keyword = "socorro";
+        }
+
+        VoiceEmergencyDetector detector = new VoiceEmergencyDetector(keyword);
+
+        EmergencyEvent event = detector.detectVoiceEmergency();
+
+        if (event != null) {
+            AlertSender sender = new AlertSender();
+            sender.sendAlert(event);
+        } else {
+            System.out.println("No se detectó ninguna palabra de emergencia.");
+        }
+    }
+}
